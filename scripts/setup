#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

sudo apt-get update -qq && sudo apt-get install -y -qq --no-install-recommends ffmpeg libpcap-dev libturbojpeg0 mosquitto mosquitto-clients

sudo apt-get install -y -qq --no-install-recommends nodejs npm

python3 -m pip install --upgrade pip -r requirements.txt
sudo npm install -g concurrently
pre-commit install


# Disable xterm focus-reporting on shell startup. Some TUIs (notably tmux on
# the host) leave it enabled, leaking ^[[O / ^[[I sequences into the prompt
# on focus changes. Idempotent — only appends if not already present.
grep -qF '1004l' ~/.bashrc || echo "printf '\e[?1004l'" >> ~/.bashrc
